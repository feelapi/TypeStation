{
  "name": "TypeStation",
  "description": "基于Bentley Systems, Inc开源的iTwinjs-core开发的桌面CAD软件。",
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "node": "^20.11.0 || ^22.0.0 || ^24.0.0"
  },
  "private": true,
  "scripts": {
    "build": "npm run -s build:frontend && npm run -s build:backend",
    "build:stats": "cross-env OUTPUT_STATS=TRUE npm run build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "tsc && cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build",
    "build:frontend-vite": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build",
    "clean": "rimraf -g build lib .static-assets .rush/temp/package-deps*.json",
    "docs": "",
    "lint": "eslint -f visualstudio \"./src/**/*.ts\" 1>&2",
    "start": "cross-env NODE_ENV=development run-p start:webserver start:electron",
    "start:electron": "electron ./lib/backend/DtaElectronMain.js",
    "start:webserver": "cross-env NODE_ENV=development vite",
    "start:backend": "node --max-http-header-size=16000 lib/backend/WebMain.js",
    "start:servers": "run-p \"start:webserver\" \"start:backend\"",
    "test": "",
    "cover": "",
    "copy:config": "internal-tools copy-config"
  },
  "repository": {},
  "dependencies": {
    "@bentley/icons-generic": "^1.0.34",
    "@bentley/icons-generic-webfont": "^1.0.34",
    "@itwin/appui-abstract": "5.14.4",
    "@itwin/browser-authorization": "^2.0.4",
    "@itwin/core-backend": "5.14.4",
    "@itwin/core-bentley": "5.14.4",
    "@itwin/core-common": "5.14.4",
    "@itwin/core-frontend": "5.14.4",
    "@itwin/core-geometry": "5.14.4",
    "@itwin/core-i18n": "5.14.4",
    "@itwin/core-markup": "5.14.4",
    "@itwin/core-quantity": "5.14.4",
    "@itwin/editor-backend": "5.14.4",
    "@itwin/editor-common": "5.14.4",
    "@itwin/editor-frontend": "5.14.4",
    "@itwin/frontend-devtools": "5.14.4",
    "@itwin/frontend-tiles": "5.14.4",
    "@itwin/hypermodeling-frontend": "5.14.4",
    "@itwin/map-layers-formats": "5.14.4",
    "@itwin/object-storage-core": "^3.1.3",
    "@itwin/reality-data-client": "^1.6.0",
    "@itwin/webgl-compatibility": "5.14.4",
    "body-parser": "^1.20.4",
    "vhacd-js": "^0.0.1"
  },
  "devDependencies": {
    "@itwin/build-tools": "5.14.4",
    "@itwin/eslint-plugin": "^6.1.1",
    "@types/express": "^4.17.20",
    "@types/express-ws": "^3.0.3",
    "@types/fs-extra": "^4.0.7",
    "@types/node": "~20.17.0",
    "@typescript-eslint/parser": "~8.71.0",
    "browserslist-to-esbuild": "^1.2.0",
    "child_process": "^1.0.2",
    "cpx2": "^8.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^5.1.0",
    "electron": "^35.0.0",
    "esbuild-plugin-external-global": "^1.0.1",
    "eslint": "^9.31.0",
    "express": "^4.22.1",
    "express-ws": "^5.0.2",
    "fs-extra": "^8.1.0",
    "node-simctl": "~7.6.1",
    "npm-run-all2": "^7.0.2",
    "react": "^18.0.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-ignore": "^1.0.10",
    "rollup-plugin-visualizer": "^5.14.0",
    "rollup-plugin-webpack-stats": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "vite": "^6.4.4",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-inspect": "^11.4.1"
  },
  "browserslist": [
    "last 4 chrome version",
    "last 4 firefox version",
    "last 4 safari version",
    "last 4 ios version",
    "last 4 ChromeAndroid version",
    "last 4 edge version",
    "not dead",
    "not <0.2%"
  ],
  "allowScripts": {
    "electron": true,
    "@bentley/imodeljs-native": true,
    "esbuild": true
  }
}
